# Copy to `.env.local` (gitignored). These are read only on the server (BFF routes),
# never shipped to the browser.

# Where the platform's API gateway lives. Local dev = the gateway on :8080.
GATEWAY_URL=http://localhost:8080

# Name of the httpOnly cookie that holds the platform JWT.
SESSION_COOKIE=ecom_session

# "Sign in with Microsoft" (optional; leave blank to hide the button).
# Fill in after the Entra app registration exists.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_AUTHORITY=
NEXT_PUBLIC_ENTRA_SCOPE=
